# ---- Secrets: never push these ----
# director/saves/director.json holds a live Gemini API key.
saves/
.env
.env.*
*.env.local

# ---- Per-machine / tool state ----
.vercel/
node_modules/

# ---- OS and editor junk ----
Thumbs.db
desktop.ini
.DS_Store
__pycache__/
*.pyc

# rendered lesson videos (large; upload to YouTube instead)
lessons/video/

# Generated exports: .docx books are built from the .md source via
# tools/md2docx.py; regenerate locally instead of committing the binary.
*.docx

# D&D bench logs stay on the computer that ran them
dnd/director/*.log
v3/director/*.log
