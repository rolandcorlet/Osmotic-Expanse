# ---- Secrets: never push these ----
# director/saves/director.json holds a live Gemini API key.
saves/
.env
.env.*
*.env.local

# ---- Per-machine / tool state ----
.vercel/
node_modules/

# ---- OS and editor junk ----
Thumbs.db
desktop.ini
.DS_Store
__pycache__/
*.pyc

# rendered lesson videos (large; upload to YouTube instead)
lessons/video/

# Generated exports: .docx books are built from the .md source via
# tools/md2docx.py; regenerate locally instead of committing the binary.
*.docx

# D&D bench logs stay on the computer that ran them
dnd/director/*.log
# ...with their status, GPU readings and exit codes (tools/bench-watch.mjs)
dnd/director/*.status.json
dnd/director/*.status.json.tmp
dnd/director/*.gpu.csv
dnd/director/*.exit.txt
dnd/director/bench-stop.txt
# superseded bench logs, kept on the computer that ran them
dnd/director/bench-logs/
v3/director/*.log

# ---- Private: your own copies of the D&D books and the library built from them ----
# (dnd/director/tools/import-books.mjs writes here; nothing in it may be committed or published)
dnd/director/library/
